{
  "name": "dynamic-watchface",
  "author": "Xef",
  "version": "0.4.1",
  "scripts": {
    "test": "python3 scripts/verify-core.py && node --test tests/*.test.js && python3 scripts/test-native.py",
    "test:js": "node --test tests/*.test.js",
    "test:native": "python3 scripts/test-native.py"
  },
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "pebble-app",
    "watchface",
    "pebble-time-2"
  ],
  "private": true,
  "dependencies": {
    "@rebble/clay": "^1.0.0",
    "pebble-watchface-core": "file:vendor/pebble-watchface-core-0.2.0.tgz"
  },
  "pebble": {
    "displayName": "Dynamic",
    "uuid": "cc1281f1-3b4d-45b5-b235-6881b1fd8fbd",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery"
    ],
    "watchapp": {
      "watchface": true
    },
    "capabilities": [
      "configurable"
    ],
    "usesPermissions": [
      "ReadMusic"
    ],
    "messageKeys": [
      "TEMPERATURE",
      "REQUEST_WEATHER",
      "BACKGROUND_COLOR",
      "TEXT_COLOR",
      "DEPTH_EFFECT",
      "TEXT_SHADOW",
      "LARGE_TEXT",
      "USE_12_HOUR",
      "USE_FAHRENHEIT",
      "TEMPERATURE_FAHRENHEIT",
      "WEATHER_UPDATED_AT",
      "FORECAST_DATA",
      "FOLLOW_PEBBLE_UNITS",
      "WEATHER_LOCATION",
      "WEATHER_CLEAR",
      "SHOW_DAILY_RANGE",
      "SHOW_RAIN_CHANCE",
      "WEATHER_DETAILS",
      "LAYOUT_STYLE",
      "SHOW_WEATHER_ICON",
      "WEATHER_CONDITION",
      "COMPLICATION_DATA",
      "REQUEST_COMPLICATIONS",
      "CONTEXT_DATA",
      "REQUEST_CONTEXT",
      "SHOW_MUSIC",
      "SHOW_NOTIFICATIONS",
      "NOTIFICATION_PREVIEW",
      "NOTIFICATION_APPS",
      "SHOW_STATUS",
      "PANEL_TRANSITIONS",
      "ACCENT_COLOR",
      "ANIMATIONS",
      "CLOCK_FORMAT"
    ],
    "resources": {
      "media": [
        {
          "type": "font",
          "name": "FONT_BODY_11",
          "file": "fonts/RobotoCondensed-Bold.ttf",
          "extended": true,
          "characterRegex": "[\\u0020-\\uFFFF]"
        },
        {
          "type": "font",
          "name": "FONT_BODY_14",
          "file": "fonts/RobotoCondensed-Bold.ttf",
          "extended": true,
          "characterRegex": "[\\u0020-\\uFFFF]"
        },
        {
          "type": "font",
          "name": "FONT_BODY_16",
          "file": "fonts/RobotoCondensed-Bold.ttf",
          "extended": true,
          "characterRegex": "[\\u0020-\\uFFFF]"
        },
        {
          "type": "font",
          "name": "FONT_BODY_20",
          "file": "fonts/RobotoCondensed-Bold.ttf",
          "extended": true,
          "characterRegex": "[\\u0020-\\uFFFF]"
        },
        {
          "type": "font",
          "name": "FONT_BODY_24",
          "file": "fonts/RobotoCondensed-Bold.ttf",
          "extended": true,
          "characterRegex": "[\\u0020-\\uFFFF]"
        },
        {
          "type": "font",
          "name": "FONT_BODY_26",
          "file": "fonts/RobotoCondensed-Bold.ttf",
          "extended": true,
          "characterRegex": "[\\u0020-\\uFFFF]"
        },
        {
          "type": "font",
          "name": "FONT_BODY_28",
          "file": "fonts/RobotoCondensed-Bold.ttf",
          "extended": true,
          "characterRegex": "[\\u0020-\\uFFFF]"
        },
        {
          "type": "font",
          "name": "FONT_BODY_32",
          "file": "fonts/RobotoCondensed-Bold.ttf",
          "extended": true,
          "characterRegex": "[\\u0020-\\uFFFF]"
        }
      ]
    }
  },
  "description": "A playful Pebble Time 2 watchface with chunky time, two complications and animated music and notification layouts.",
  "repository": {
    "type": "git",
    "url": "https://github.com/xefensor/dynamic-watchface.git"
  }
}
